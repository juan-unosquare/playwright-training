{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "commonjs",
        "moduleResolution": "node",
        "types": ["node", "@playwright/test"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true
    },

    "include": ["tests/**/*.ts", "playwright.config.ts"]
}